# Backend
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_runtime

# SDK (used by examples / agent code)
AGENT_TRACE_HOST=http://localhost:8000
AGENT_TRACE_PUBLIC_KEY=
AGENT_TRACE_SECRET_KEY=

# Project isolation (administrator token is created by start.ps1; do not commit it)
SENTINEL_ALLOW_LOCAL=1
SENTINEL_ADMIN_TOKEN=
SENTINEL_PROJECT_KEY=
SENTINEL_PROJECT_DATA=D:/agent-runtime/data/projects
AGENT_TRACE_OUTBOX=D:/CodexWork/cache/sentinellab/outbox.db

# Real model provider (keys stay server-side; endpoint is not controlled by job payload)
SENTINEL_LLM_BASE_URL=http://127.0.0.1:8081/v1
SENTINEL_LLM_MODEL=sentinel-qwen
SENTINEL_LLM_KEY=
